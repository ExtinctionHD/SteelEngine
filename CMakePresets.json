{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 1 },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/Build/VS2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "targets": ["SteelEngine"]
    },
    {
      "name": "release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "targets": ["SteelEngine"]
    }
  ]
}
